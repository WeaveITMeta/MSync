# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_REPO_OWNER=your_github_username_or_org
GITHUB_REPO_NAME=your_repository_name

# CodeRabbit Configuration
CODERABBIT_API_KEY=your_coderabbit_api_key

# Database
DATABASE_URL=sqlite://dsync.db

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Logging
RUST_LOG=info,dsync=debug

# Discord role IDs for merit roles (right-click role > Copy Role ID, Developer Mode on)
DISCORD_ROLE_ID_NEWCOMER=
DISCORD_ROLE_ID_CONTRIBUTOR=
DISCORD_ROLE_ID_ACTIVE_CONTRIBUTOR=
DISCORD_ROLE_ID_CORE_CONTRIBUTOR=
DISCORD_ROLE_ID_MAINTAINER=

# Guild to register slash commands in (/link, /stats, /leaderboard, /sync, /payouts)
DISCORD_GUILD_ID=

# --- Payment model (placeholder defaults shown) ---
# Branches whose merged PRs create a pending_approval ledger row
DSYNC_PAY_BRANCHES=main,upcoming
# Base amount in cents per tracked branch: DSYNC_PAY_BASE_CENTS_<BRANCH uppercased, non-alnum -> _>
DSYNC_PAY_BASE_CENTS_DEFAULT=1000
DSYNC_PAY_BASE_CENTS_MAIN=1000
DSYNC_PAY_BASE_CENTS_UPCOMING=500
# amount = base * (1 + merit_points * multiplier), capped at DSYNC_PAY_MAX_CENTS
DSYNC_PAY_MERIT_MULTIPLIER=0.01
DSYNC_PAY_MAX_CENTS=10000
DSYNC_PAY_CURRENCY=usd

# --- Stripe Connect (Express) ---
# Use a test key (sk_test_...). Live keys are refused unless DSYNC_STRIPE_ALLOW_LIVE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DSYNC_STRIPE_ALLOW_LIVE=false
# Public base URL of this server (Stripe onboarding refresh/return links)
DSYNC_PUBLIC_URL=http://localhost:8080

# Bearer token for /api/admin/* and /api/payouts/onboard (admin API disabled if empty)
DSYNC_ADMIN_TOKEN=
