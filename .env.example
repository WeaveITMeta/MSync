# MSync (MeritSync) configuration. Every MSYNC_* name below was DSYNC_* before the rename;
# an old DSYNC_* name is still read, with a startup warning, only while its MSYNC_* twin is unset.

# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_REPO_OWNER=your_github_username_or_org
GITHUB_REPO_NAME=your_repository_name

# CodeRabbit (optional). CodeRabbit is only a scorer source; with no score a merge earns base points.
CODERABBIT_API_KEY=

# GitLab webhooks (POST /gitlab/webhook). Compared in constant time against X-Gitlab-Token.
# Unset or empty: every GitLab webhook is rejected.
GITLAB_WEBHOOK_SECRET=

# Repositories whose events earn merit: comma list of provider:host:path[:flag[:flag]]
# flags: mirror (earns nothing, no payout row), private (never named on public responses)
# Unset or empty: GitHub behaves as before (every repo earns) and GitLab is refused.
# Example: github:github.com:EustressEngine/eustress,gitlab:gitlab.com:eustress/eustress:mirror
MSYNC_FOUNDRY_REPOS=

# Database. The default file keeps its pre-rename name so an existing deployment keeps its data.
DATABASE_URL=sqlite://dsync.db

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Logging
RUST_LOG=info,msync=debug

# Discord role IDs for merit roles (right-click role > Copy Role ID, Developer Mode on)
DISCORD_ROLE_ID_NEWCOMER=
DISCORD_ROLE_ID_CONTRIBUTOR=
DISCORD_ROLE_ID_ACTIVE_CONTRIBUTOR=
DISCORD_ROLE_ID_CORE_CONTRIBUTOR=
DISCORD_ROLE_ID_MAINTAINER=

# Guild to register slash commands in (/link, /stats, /leaderboard, /sync, /payouts)
DISCORD_GUILD_ID=

# --- Payment model (placeholder defaults shown) ---
# Branches whose merged PRs create a pending_approval ledger row
MSYNC_PAY_BRANCHES=main,upcoming
# Base amount in cents per tracked branch: MSYNC_PAY_BASE_CENTS_<BRANCH uppercased, non-alnum -> _>
MSYNC_PAY_BASE_CENTS_DEFAULT=1000
MSYNC_PAY_BASE_CENTS_MAIN=1000
MSYNC_PAY_BASE_CENTS_UPCOMING=500
# amount = base * (1 + merit_points * multiplier), capped at MSYNC_PAY_MAX_CENTS
MSYNC_PAY_MERIT_MULTIPLIER=0.01
MSYNC_PAY_MAX_CENTS=10000
MSYNC_PAY_CURRENCY=usd

# --- Stripe Connect (Express) ---
# Use a test key (sk_test_...). Live keys are refused unless MSYNC_STRIPE_ALLOW_LIVE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MSYNC_STRIPE_ALLOW_LIVE=false
# Public base URL of this server (Stripe onboarding refresh/return links)
MSYNC_PUBLIC_URL=http://localhost:8080

# Bearer token for /api/admin/* and /api/payouts/onboard (admin API disabled if empty)
MSYNC_ADMIN_TOKEN=

# --- API tokens and payout controls (/api/v1) ---
# Member ids with owner rank (1000). Only ranked members can approve when the payout policy
# sets approval.min_approver_rank > 0. Engine configuration, never CRA content.
MSYNC_OWNER_MEMBER_IDS=
# Payout scheduler tick in seconds (0 disables). Runs are created per the stored payout policy schedule.
# Each tick also turns due pay order occurrences into ledger rows (never a transfer; docs/PAYROLL.md).
# With the scheduler disabled, pay orders record nothing.
MSYNC_PAYOUT_SCHEDULER_SECS=60
# Role sync timer in seconds (default 300; 0 disables the timer). Discord roles and Slack user
# groups are reconciled to the CRA projection; drift is reverted and reported (docs/DISCORD.md
# section 5, docs/SLACK.md section 6). Activation, member joins and /sync still trigger runs.
MSYNC_ROLE_SYNC_SECS=300

# --- Central Rank Authority (CRA): the hierarchy from .msync/ in a repository (docs/CRA_CONFIG.md section 14) ---
# provider:host:path of the CRA repository. Unset: no CRA loading; ranks from MSYNC_OWNER_MEMBER_IDS only.
# Example: github:github.com:EustressEngine/msync-cra
MSYNC_CRA_REPO=
# Branch whose verified pushes load the CRA (default main)
MSYNC_CRA_BRANCH=main
# Read token for a GitLab CRA repository (read_api). GitHub uses GITHUB_TOKEN.
GITLAB_TOKEN=
# Optional API base overrides (GitHub Enterprise, tests)
MSYNC_CRA_GITHUB_API=
MSYNC_CRA_GITLAB_API=
# MSYNC_OWNER_MEMBER_IDS also accepts provider:login entries (github:Simbuilder, gitlab:someone).
# Only that form can bootstrap the first CRA snapshot.
# --- MCP server (POST /mcp, same API tokens and scopes as /api/v1) ---
# payouts_run_execute moves money. It is hidden and refused over MCP unless this is "true" (any other value, or unset, is off).
# Leave it off unless an operator has decided that agents may execute payout runs.
MSYNC_MCP_ALLOW_EXECUTE=false

# --- Sign-in and "Sign in with MSync" (docs/SIGN_IN.md) ---
# Each sign-in provider is enabled only when BOTH its client id and secret are set. Register the
# redirect URI <MSYNC_PUBLIC_URL>/auth/<provider>/callback at the provider, exactly.
MSYNC_OAUTH_GITHUB_CLIENT_ID=
MSYNC_OAUTH_GITHUB_CLIENT_SECRET=
MSYNC_OAUTH_GITLAB_CLIENT_ID=
MSYNC_OAUTH_GITLAB_CLIENT_SECRET=
# Self-hosted GitLab only: MSYNC_OAUTH_GITLAB_AUTHORIZE_URL, MSYNC_OAUTH_GITLAB_TOKEN_URL, MSYNC_OAUTH_GITLAB_API_BASE
MSYNC_OAUTH_DISCORD_CLIENT_ID=
MSYNC_OAUTH_DISCORD_CLIENT_SECRET=
MSYNC_OAUTH_SLACK_CLIENT_ID=
MSYNC_OAUTH_SLACK_CLIENT_SECRET=
MSYNC_OAUTH_GOOGLE_CLIENT_ID=
MSYNC_OAUTH_GOOGLE_CLIENT_SECRET=
# MSync as an OAuth/OpenID Connect provider for platforms: 32 bytes as 64 hex characters (or base64).
# It seals the token signing key in the database. Unset: every /oauth/* endpoint answers 503.
MSYNC_KEY_ENCRYPTION_KEY=
